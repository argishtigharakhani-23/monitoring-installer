global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:__PROM_PORT__']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['__NODE_IP__:__NODE_PORT__']

  - job_name: 'pushgateway'
    static_configs:
      - targets: ['__PUSHGATEWAY_IP__:__PUSHGATEWAY_PORT__']
